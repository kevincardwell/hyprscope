# Regenerate with: vhs assets/demo.tape   (needs vhs, ttyd, ffmpeg)
Output assets/demo.gif
Set Shell "bash"
Set FontSize 15
Set FontFamily "DejaVu Sans Mono"
Set Width 1500
Set Height 620
Set Padding 16
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms

Type "hyprscope why brave" Enter
Sleep 3s
Type "clear" Enter
Type "hyprscope" Enter
Sleep 2s
Tab
Sleep 800ms
Down
Sleep 1.5s
Type "m"
Sleep 2s
Down Down Down Down
Sleep 1.5s
Type "/"
Type "tag:terminal"
Sleep 1.5s
Enter
Sleep 1s
Type "y"
Sleep 2s
Type "q"
Sleep 300ms
Type "clear" Enter
Type "hyprscope lint" Enter
Sleep 3.5s
